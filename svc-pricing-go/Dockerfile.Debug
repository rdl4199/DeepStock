FROM golang:1.22-alpine

# tools + certs
RUN apk add --no-cache git curl bash ca-certificates

WORKDIR /app
COPY . .

# deps + debug build (no optimizations)
RUN go mod tidy
ENV CGO_ENABLED=0
RUN go build -gcflags "all=-N -l" -o /app/svc-debug

# install Delve (go puts it in /root/go/bin)
RUN go install github.com/go-delve/delve/cmd/dlv@latest
ENV PATH="/root/go/bin:${PATH}"

EXPOSE 8080 40000
ENV PORT=8080

# Run Delve in DAP mode (modern). No --api-version here.
CMD ["dlv", "dap", "--listen=:40000", "--accept-multiclient", "--log"]
